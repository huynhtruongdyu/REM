@inject ResumeState State
@implements IDisposable

<div class="resume-preview theme-@(State.Resume.Theme ?? "default") scheme-@(State.Resume.ColorScheme ?? "blue")">
    @if (HasPersonal())
    {
        <header class="rp-header">
            <h1>@State.Resume.Personal.FullName</h1>
            @if (!string.IsNullOrWhiteSpace(State.Resume.Personal.Title))
            {
                <div class="rp-title">@State.Resume.Personal.Title</div>
            }
            <div class="rp-contact">
                @{
                    var contacts = ContactItems();
                    for (var i = 0; i < contacts.Count; i++)
                    {
                        var c = contacts[i];
                        if (c.href is not null)
                        {
                            <a href="@c.href" target="_blank" rel="noopener noreferrer">@c.text</a>
                        }
                        else
                        {
                            <span>@c.text</span>
                        }

                        if (i < contacts.Count - 1)
                        {
                            <text> | </text>
                        }
                    }
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(State.Resume.Personal.Summary))
            {
                <p class="rp-summary">@State.Resume.Personal.Summary</p>
            }
        </header>
    }

    @foreach (var section in State.Resume.SectionOrder)
    {
        if (State.Resume.HiddenSections.Contains(section))
        {
            continue;
        }

        switch (section)
        {
            case SectionDefinitions.Experience:
                if (State.Resume.Experiences.Count > 0)
                {
                    <section class="rp-section">
                        <h2>Experience</h2>
                        @foreach (var x in State.Resume.Experiences)
                        {
                            <div class="rp-entry">
                                <div class="rp-entry-head">
                                    <div>
                                        <span class="rp-strong">@x.Position</span>
                                        @if (!string.IsNullOrWhiteSpace(x.Company)) { <div class="rp-org">@x.Company</div> }
                                    </div>
                                    <span class="rp-dates">@DateRange(x.StartDate, x.EndDate, x.IsCurrent)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(x.Description)) { <p class="rp-desc">@x.Description</p> }
                            </div>
                        }
                    </section>
                }
                break;
            case SectionDefinitions.Education:
                if (State.Resume.Educations.Count > 0)
                {
                    <section class="rp-section">
                        <h2>Education</h2>
                        @foreach (var x in State.Resume.Educations)
                        {
                            <div class="rp-entry">
                                <div class="rp-entry-head">
                                    <div>
                                        <span class="rp-strong">@x.Degree@(string.IsNullOrWhiteSpace(x.FieldOfStudy) ? "" : $", {x.FieldOfStudy}")</span>
                                        @if (!string.IsNullOrWhiteSpace(x.Institution)) { <div class="rp-org">@x.Institution</div> }
                                    </div>
                                    <span class="rp-dates">@DateRange(x.StartDate, x.EndDate, false)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(x.Gpa)) { <div class="rp-muted">GPA: @x.Gpa</div> }
                                @if (!string.IsNullOrWhiteSpace(x.Description)) { <p class="rp-desc">@x.Description</p> }
                            </div>
                        }
                    </section>
                }
                break;
            case SectionDefinitions.Skills:
                if (State.Resume.Skills.Count > 0)
                {
                    <section class="rp-section">
                        <h2>Skills</h2>
                        <p class="rp-line">
                            @string.Join(", ", State.Resume.Skills
                                .Where(s => !string.IsNullOrWhiteSpace(s.Name))
                                .Select(s => string.IsNullOrWhiteSpace(s.Proficiency) ? s.Name : $"{s.Name} ({s.Proficiency})"))
                        </p>
                    </section>
                }
                break;
            case SectionDefinitions.Projects:
                if (State.Resume.Projects.Count > 0)
                {
                    <section class="rp-section">
                        <h2>Projects</h2>
                        @foreach (var x in State.Resume.Projects)
                        {
                            <div class="rp-entry">
                                <div class="rp-entry-head">
                                    <div>
                                        <span class="rp-strong">@x.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(x.Url))
                                        {
                                            var url = Href(x.Url);
                                            if (url is not null)
                                            {
                                                <a class="rp-org d-block" href="@url" target="_blank" rel="noopener noreferrer">@x.Url</a>
                                            }
                                            else
                                            {
                                                <div class="rp-org">@x.Url</div>
                                            }
                                        }
                                    </div>
                                    <span class="rp-dates">@DateRange(x.StartDate, x.EndDate, false)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(x.Description)) { <p class="rp-desc">@x.Description</p> }
                                @if (x.Technologies.Count > 0) { <div class="rp-muted">@string.Join(", ", x.Technologies)</div> }
                            </div>
                        }
                    </section>
                }
                break;
            case SectionDefinitions.Certifications:
                if (State.Resume.Certifications.Count > 0)
                {
                    <section class="rp-section">
                        <h2>Certifications</h2>
                        @foreach (var x in State.Resume.Certifications)
                        {
                            <div class="rp-entry">
                                <div class="rp-entry-head">
                                    <span class="rp-strong">@x.Name</span>
                                    <span class="rp-dates">@x.IssueDate.Year@(x.ExpiryDate.HasValue ? $" – {x.ExpiryDate.Value.Year}" : "")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(x.Issuer)) { <div class="rp-org">@x.Issuer</div> }
                                @if (!string.IsNullOrWhiteSpace(x.CredentialId)) { <div class="rp-muted">Credential ID: @x.CredentialId</div> }
                            </div>
                        }
                    </section>
                }
                break;
            case SectionDefinitions.Languages:
                if (State.Resume.Languages.Count > 0)
                {
                    <section class="rp-section">
                        <h2>Languages</h2>
                        <p class="rp-line">
                            @string.Join(", ", State.Resume.Languages
                                .Where(l => !string.IsNullOrWhiteSpace(l.Name))
                                .Select(l => string.IsNullOrWhiteSpace(l.Proficiency) ? l.Name : $"{l.Name} ({l.Proficiency})"))
                        </p>
                    </section>
                }
                break;
        }
    }
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private bool HasPersonal()
    {
        var p = State.Resume.Personal;
        return new[] { p.FullName, p.Title, p.Email, p.Phone, p.Location, p.Website, p.LinkedIn, p.GitHub, p.Summary }
            .Any(v => !string.IsNullOrWhiteSpace(v));
    }

    private static string? Href(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        var v = value.Trim();
        if (v.StartsWith("javascript:", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        if (v.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || v.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return v;
        }

        if (v.StartsWith("//"))
        {
            return "https:" + v;
        }

        if (v.Contains('.') || v.StartsWith("www.", StringComparison.OrdinalIgnoreCase))
        {
            return "https://" + v.TrimStart('/');
        }

        return null;
    }

    private static string? EmailHref(string? email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return null;
        }

        if (email!.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase))
        {
            return email;
        }

        return email.Contains('@') ? "mailto:" + email : Href(email);
    }

    private static string? PhoneHref(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            return null;
        }

        var digits = new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray());
        return digits.Length > 0 ? "tel:" + digits : null;
    }

    private List<(string text, string? href)> ContactItems()
    {
        var p = State.Resume.Personal;
        var items = new List<(string, string?)>();
        if (!string.IsNullOrWhiteSpace(p.Email)) items.Add((p.Email!, EmailHref(p.Email)));
        if (!string.IsNullOrWhiteSpace(p.Phone)) items.Add((p.Phone!, PhoneHref(p.Phone)));
        if (!string.IsNullOrWhiteSpace(p.Location)) items.Add((p.Location!, null));
        if (!string.IsNullOrWhiteSpace(p.Website)) items.Add((p.Website!, Href(p.Website)));
        if (!string.IsNullOrWhiteSpace(p.LinkedIn)) items.Add((p.LinkedIn!, Href(p.LinkedIn)));
        if (!string.IsNullOrWhiteSpace(p.GitHub)) items.Add((p.GitHub!, Href(p.GitHub)));
        return items;
    }

    private static string DateRange(DateOnly? start, DateOnly? end, bool current)
    {
        if (!start.HasValue && !end.HasValue)
        {
            return "";
        }

        var endText = current ? "Present" : (end.HasValue ? end.Value.ToString("MMM yyyy") : "");
        return $"{(start.HasValue ? start.Value.ToString("MMM yyyy") : "")} – {endText}";
    }
}
