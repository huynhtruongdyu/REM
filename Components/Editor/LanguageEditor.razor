@inject ResumeState State

<EditForm EditContext="State.EditContext">
    <SectionListEditor Title="Languages"
                       Items="State.Resume.Languages"
                       Factory="() => new Language { Id = Guid.NewGuid() }"
                       KeySelector="e => e.Id"
                       Context="item">
        <ItemFields>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Name</label>
                    <InputText class="form-control" @bind-Value="item.Name" @bind:event="oninput" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Proficiency</label>
                    <InputText class="form-control" @bind-Value="item.Proficiency" @bind:event="oninput" />
                </div>
            </div>
        </ItemFields>
    </SectionListEditor>
</EditForm>
