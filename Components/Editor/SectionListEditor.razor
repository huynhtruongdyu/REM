@typeparam TItem
@inject ResumeState State
@implements IDisposable

<div class="card mb-3 editor-section">
    <div class="card-header d-flex flex-items-center gap-2">
        <span class="section-drag-handle flex-1 @(IsHidden() ? "text-decoration-line-through color-fg-muted" : "")">@Title</span>
        <button type="button" class="btn btn-sm btn-link py-0 px-1 section-visibility-toggle"
                title="Show or hide this section in the resume" @onclick="ToggleVisibility" @onclick:stopPropagation>
            @(IsHidden() ? "Show" : "Hide")
        </button>
        <button type="button" class="btn btn-sm btn-link py-0 px-1 collapse-toggle" title="Collapse / expand"
                @onclick="ToggleCollapse" @onclick:stopPropagation>
            @(State.IsSectionCollapsed(Key) ? "▸" : "▾")
        </button>
    </div>
    <div class="card-body @(State.IsSectionCollapsed(Key) ? "d-none" : "")">
        <SortableList Items="Items" KeySelector="KeySelector" OnReorder="Reorder" Context="item">
            <ItemTemplate>
                <div class="border rounded p-2 mb-2">
                <div class="d-flex flex-justify-between flex-items-center mb-2">
                    <span class="drag-handle" title="Drag to reorder">&#10303;</span>
                    <button class="btn btn-sm btn-outline color-fg-danger" @onclick="() => Remove(item)">Remove</button>
                </div>
                    @ItemFields(item)
                </div>
            </ItemTemplate>
        </SortableList>
        <button class="btn btn-sm btn-primary" @onclick="Add">Add</button>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string SectionKey { get; set; } = "";

    [Parameter]
    public IList<TItem> Items { get; set; } = [];

    [Parameter]
    public Func<TItem, object> KeySelector { get; set; } = default!;

    [Parameter]
    public Func<TItem> Factory { get; set; } = () => default!;

    [Parameter]
    public RenderFragment<TItem> ItemFields { get; set; } = default!;

    protected override void OnInitialized() => State.OnChange += StateHasChanged;

    public void Dispose() => State.OnChange -= StateHasChanged;

    private string Key => string.IsNullOrEmpty(SectionKey) ? Title : SectionKey;

    private bool IsHidden() => State.Resume.HiddenSections.Contains(Key);

    private void ToggleVisibility()
    {
        var key = Key;
        var hidden = State.Resume.HiddenSections;
        if (hidden.Contains(key))
        {
            hidden.Remove(key);
        }
        else
        {
            hidden.Add(key);
        }

        State.MarkDirty();
    }

    private void ToggleCollapse() => State.ToggleSectionCollapsed(Key);

    private void Add()
    {
        Items.Add(Factory());
        State.MarkDirty();
    }

    private void Remove(TItem item)
    {
        Items.Remove(item);
        State.MarkDirty();
    }

    private void Reorder((int oldIndex, int newIndex) e)
    {
        if (e.oldIndex == e.newIndex)
        {
            return;
        }

        var item = Items[e.oldIndex];
        Items.RemoveAt(e.oldIndex);
        Items.Insert(e.newIndex, item);
        State.MarkDirty();
    }
}
