@typeparam TItem
@inject ResumeState State
@implements IDisposable

<div class="Box mb-3 editor-section">
    <div class="Box-header d-flex flex-items-center gap-2">
        @if (CanRename)
        {
            @if (_editingTitle)
            {
                <input class="form-control form-control-sm flex-1" placeholder="Section title" @ref="_titleInput"
                       value="@TitleValue" @oninput="e => OnTitleChanged((string?)e.Value)"
                       @onblur="ExitTitleEdit" @onkeydown="OnTitleKey" />
                <button type="button" class="btn btn-sm btn-link py-0 px-1" title="Done editing title"
                        @onclick="ExitTitleEdit" @onclick:stopPropagation>✓</button>
            }
            else
            {
                <h3 class="Box-title section-drag-handle flex-1 @(IsHidden() ? "text-decoration-line-through color-fg-muted" : "")">@TitleValue</h3>
                <button type="button" class="btn btn-sm btn-link py-0 px-1" title="Edit section title"
                        @onclick="StartTitleEdit" @onclick:stopPropagation>Rename</button>
            }
        }
        else
        {
            <h3 class="Box-title section-drag-handle flex-1 @(IsHidden() ? "text-decoration-line-through color-fg-muted" : "")">@Title</h3>
        }
        <button type="button" class="btn btn-sm btn-link py-0 px-1 section-visibility-toggle"
                title="Show or hide this section in the resume" @onclick="ToggleVisibility" @onclick:stopPropagation>
            @(IsHidden() ? "Show" : "Hide")
        </button>
        @if (CanRemove)
        {
            <button type="button" class="btn btn-sm btn-link py-0 px-1 color-fg-danger" title="Remove this section"
                    @onclick="() => OnRemove.InvokeAsync(null)" @onclick:stopPropagation>
                Remove
            </button>
        }
        <button type="button" class="btn btn-sm btn-link py-0 px-1 collapse-toggle" title="Collapse / expand"
                @onclick="ToggleCollapse" @onclick:stopPropagation>
            @(State.IsSectionCollapsed(Key) ? "▸" : "▾")
        </button>
    </div>
    <div class="Box-body @(State.IsSectionCollapsed(Key) ? "d-none" : "")">
        <SortableList Items="Items" KeySelector="KeySelector" OnReorder="Reorder" Context="item">
            <ItemTemplate>
                <div class="Box mb-3">
                    <div class="Box-header d-flex flex-justify-between flex-items-center py-2 px-3">
                        <span class="drag-handle" title="Drag to reorder">&#10303;</span>
                        <button class="btn btn-sm btn-danger" @onclick="() => Remove(item)">Remove</button>
                    </div>
                    <div class="Box-body p-3">
                        @ItemFields(item)
                    </div>
                </div>
            </ItemTemplate>
        </SortableList>
        <button class="btn btn-sm btn-primary" @onclick="Add">Add</button>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public string SectionKey { get; set; } = "";

    [Parameter]
    public IList<TItem> Items { get; set; } = [];

    [Parameter]
    public Func<TItem, object> KeySelector { get; set; } = default!;

    [Parameter]
    public Func<TItem> Factory { get; set; } = () => default!;

    [Parameter]
    public RenderFragment<TItem> ItemFields { get; set; } = default!;

    [Parameter]
    public bool CanRename { get; set; }

    [Parameter]
    public string? TitleValue { get; set; }

    [Parameter]
    public EventCallback<string> TitleValueChanged { get; set; }

    [Parameter]
    public bool CanRemove { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private void OnTitleChanged(string? value)
    {
        TitleValue = value;
        TitleValueChanged.InvokeAsync(value);
        State.MarkDirty();
    }

    private bool _editingTitle;
    private ElementReference _titleInput;

    private async Task StartTitleEdit()
    {
        _editingTitle = true;
        await InvokeAsync(StateHasChanged);
        await _titleInput.FocusAsync();
    }

    private void ExitTitleEdit() => _editingTitle = false;

    private void OnTitleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == "Escape")
        {
            ExitTitleEdit();
        }
    }

    protected override void OnInitialized() => State.OnChange += StateHasChanged;

    public void Dispose() => State.OnChange -= StateHasChanged;

    private string Key => string.IsNullOrEmpty(SectionKey) ? Title : SectionKey;

    private bool IsHidden() => State.Resume.HiddenSections.Contains(Key);

    private void ToggleVisibility()
    {
        var key = Key;
        var hidden = State.Resume.HiddenSections;
        if (hidden.Contains(key))
        {
            hidden.Remove(key);
        }
        else
        {
            hidden.Add(key);
        }

        State.MarkDirty();
    }

    private void ToggleCollapse() => State.ToggleSectionCollapsed(Key);

    private void Add()
    {
        Items.Add(Factory());
        State.MarkDirty();
    }

    private void Remove(TItem item)
    {
        Items.Remove(item);
        State.MarkDirty();
    }

    private void Reorder((int oldIndex, int newIndex) e)
    {
        if (e.oldIndex == e.newIndex)
        {
            return;
        }

        var item = Items[e.oldIndex];
        Items.RemoveAt(e.oldIndex);
        Items.Insert(e.newIndex, item);
        State.MarkDirty();
    }
}
