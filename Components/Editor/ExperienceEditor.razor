@inject ResumeState State

<EditForm EditContext="State.EditContext">
    <SectionListEditor Title="Experience"
                       Items="State.Resume.Experiences"
                       Factory="() => new Experience { Id = Guid.NewGuid() }"
                       KeySelector="e => e.Id"
                       Context="item">
        <ItemFields>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Company</label>
                    <InputText class="form-control" @bind-Value="item.Company" @bind:event="oninput" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Position</label>
                    <InputText class="form-control" @bind-Value="item.Position" @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Start</label>
                    <InputDate class="form-control" @bind-Value="item.StartDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">End</label>
                    <InputDate class="form-control" @bind-Value="item.EndDate" disabled="@item.IsCurrent" />
                </div>
                <div class="col-md-4 d-flex flex-items-end">
                    <label class="form-checkbox">
                        <input type="checkbox" checked="@item.IsCurrent"
                               @onchange="e => OnCurrentChanged(item, (bool)(e.Value ?? false))" />
                        Current
                    </label>
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" @bind-Value="item.Description" @bind:event="oninput" />
                </div>
            </div>
        </ItemFields>
    </SectionListEditor>
</EditForm>

@code {
    private void OnCurrentChanged(Experience item, bool current)
    {
        item.IsCurrent = current;
        if (current)
        {
            item.EndDate = null;
        }

        State.MarkDirty();
    }
}
