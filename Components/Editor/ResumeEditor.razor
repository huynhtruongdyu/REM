@inject ResumeState State

<PersonalInfoEditor />

<div class="d-flex flex-justify-end gap-2 mb-2">
    <div class="dropdown">
        <button class="btn btn-sm btn-outline dropdown-toggle" type="button" @onclick="ToggleAddMenu"
                aria-expanded="@_addMenuOpen">Add section<span class="dropdown-caret"></span></button>
        @if (_addMenuOpen)
        {
            <ul class="dropdown-menu dropdown-menu-end show">
                <li><button class="dropdown-item" @onclick="AddCustomSection">Custom section</button></li>
                @foreach (var name in SectionDefinitions.AllSections.Where(s => !State.Resume.SectionOrder.Contains(s)))
                {
                    <li><button class="dropdown-item" @onclick="() => AddFixedSection(name)">@name</button></li>
                }
            </ul>
        }
    </div>
    <button class="btn btn-sm btn-outline" @onclick="() => State.CollapseAllSections()">Collapse all</button>
    <button class="btn btn-sm btn-outline" @onclick="() => State.ExpandAllSections()">Expand all</button>
</div>

<SortableList Items="State.Resume.SectionOrder" KeySelector="s => s" OnReorder="ReorderSections" Context="section" Handle=".section-drag-handle">
    <ItemTemplate>
        @switch (section)
        {
            case SectionDefinitions.Experience:
                <ExperienceEditor />
                break;
            case SectionDefinitions.Education:
                <EducationEditor />
                break;
            case SectionDefinitions.Skills:
                <SkillEditor />
                break;
            case SectionDefinitions.Projects:
                <ProjectEditor />
                break;
            case SectionDefinitions.Certifications:
                <CertificationEditor />
                break;
            case SectionDefinitions.Languages:
                <LanguageEditor />
                break;
            case var key when SectionDefinitions.IsCustom(key):
                var custom = State.Resume.CustomSections.FirstOrDefault(c => c.Id == SectionDefinitions.CustomId(key));
                if (custom is not null)
                {
                    <CustomSectionEditor Section="custom" />
                }
                break;
        }
    </ItemTemplate>
</SortableList>

@if (_addMenuOpen)
{
    <div class="dropdown-backdrop" @onclick="() => _addMenuOpen = false"></div>
}

@code {
    private bool _addMenuOpen;

    private void ToggleAddMenu() => _addMenuOpen = !_addMenuOpen;

    private void AddCustomSection()
    {
        var section = new CustomSection();
        State.Resume.CustomSections.Add(section);
        State.Resume.SectionOrder.Add(SectionDefinitions.CustomKey(section.Id));
        State.MarkDirty();
        _addMenuOpen = false;
    }

    private void AddFixedSection(string name)
    {
        if (!State.Resume.SectionOrder.Contains(name))
        {
            State.Resume.SectionOrder.Add(name);
            State.MarkDirty();
        }

        _addMenuOpen = false;
    }

    private void ReorderSections((int oldIndex, int newIndex) e)
    {
        if (e.oldIndex == e.newIndex)
        {
            return;
        }

        var section = State.Resume.SectionOrder[e.oldIndex];
        State.Resume.SectionOrder.RemoveAt(e.oldIndex);
        State.Resume.SectionOrder.Insert(e.newIndex, section);
        State.MarkDirty();
    }
}
