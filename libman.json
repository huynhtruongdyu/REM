{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "@primer/css@21.5.0",
      "destination": "wwwroot\\lib\\primer",
      "provider": "jsdelivr",
      "files": [
        "dist/primer.css"
      ]
    },
    {
      "library": "Sortable@1.15.6",
      "destination": "wwwroot\\lib\\sortablejs",
      "files": [
        "Sortable.min.js"
      ]
    },
    {
      "library": "html2pdf.js@0.10.2",
      "destination": "wwwroot\\lib\\html2pdf",
      "files": [
        "html2pdf.bundle.min.js"
      ]
    },
    {
      "library": "pdfmake@0.3.3",
      "destination": "wwwroot\\lib\\pdfmake",
      "provider": "jsdelivr",
      "files": [
        "build/pdfmake.min.js",
        "build/vfs_fonts.js"
      ]
    }
  ]
}