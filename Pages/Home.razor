@page "/"
@layout BuilderLayout
@using System.Linq
@inject ResumeState State
@inject StorageService Storage
@inject IJSRuntime JS
@implements IDisposable

<div class="builder-toolbar d-flex flex-wrap flex-items-center gap-2 px-3 py-2 border-bottom color-bg-default">
    <div class="mobile-header-row d-flex flex-items-center flex-justify-between w-100">
        <strong class="brand">REM</strong>
        <button class="btn btn-sm btn-outline d-md-none" @onclick="ToggleMobileMenu">
            @(_mobileMenuOpen ? "✕ Close" : "☰ Menu")
        </button>
    </div>

    <div class="toolbar-contents @(_mobileMenuOpen ? "d-flex" : "d-none d-md-flex") flex-1 flex-column flex-md-row flex-wrap flex-md-items-center gap-2 w-100">
        <div class="d-flex flex-wrap flex-items-center gap-3 pl-1 toolbar-selects">
        <div class="d-flex flex-items-center gap-2 select-group">
            <label class="form-label mb-0 small" for="themeSelect">Theme</label>
        <select id="themeSelect" class="form-select form-select-sm w-auto" value="@State.Resume.Theme"
                @onchange="OnThemeChange">
            <option value="default">Default</option>
            <option value="minimal">Minimalism</option>
            <option value="modern">Modern</option>
            <option value="classic">Classic</option>
            <option value="compact">Compact</option>
            <option value="elegant">Elegant</option>
            <option value="professional">Professional</option>
            <option value="creative">Creative</option>
            <option value="technical">Technical</option>
            <option value="bold">Bold</option>
        </select>
        </div>
        <div class="d-flex flex-items-center gap-2 select-group">
            <label class="form-label mb-0 small" for="schemeSelect">Color</label>
            <select id="schemeSelect" class="form-select form-select-sm w-auto" value="@State.Resume.ColorScheme"
                @onchange="OnSchemeChange">
            <option value="blue">Blue</option>
            <option value="indigo">Indigo</option>
            <option value="emerald">Emerald</option>
            <option value="rose">Rose</option>
            <option value="amber">Amber</option>
            <option value="violet">Violet</option>
            <option value="teal">Teal</option>
            <option value="slate">Slate</option>
            <option value="red">Red</option>
            <option value="orange">Orange</option>
            <option value="pink">Pink</option>
            <option value="cyan">Cyan</option>
            <option value="lime">Lime</option>
            <option value="purple">Purple</option>
            <option value="black">Black</option>
        </select>
        </div>
        <div class="d-flex flex-items-center gap-2 select-group">
            <label class="form-label mb-0 small" for="fontSelect">Size</label>
            <select id="fontSelect" class="form-select form-select-sm w-auto" value="@State.Resume.FontSize"
                @onchange="OnFontSizeChange">
            <option value="small">Small</option>
            <option value="medium">Medium</option>
            <option value="large">Large</option>
            <option value="xlarge">Extra Large</option>
        </select>
        </div>
    </div>

    <div class="ms-auto d-flex flex-wrap align-items-center gap-2 justify-content-end">
        <div class="btn-group">
            <button class="btn btn-sm" @onclick="() => State.Undo()" disabled="@(!State.CanUndo)"
                    title="Undo (Ctrl+Z)">Undo</button>
            <button class="btn btn-sm" @onclick="() => State.Redo()" disabled="@(!State.CanRedo)"
                    title="Redo (Ctrl+Y)">Redo</button>
        </div>

        <button class="btn btn-sm" @onclick="Import">Import</button>

        <div class="dropdown">
            <button class="btn btn-sm dropdown-toggle" type="button" @onclick="ToggleExportJsonMenu"
                    aria-expanded="@_exportJsonMenuOpen">
                Export<span class="dropdown-caret"></span>
            </button>
            @if (_exportJsonMenuOpen)
            {
                <ul class="dropdown-menu dropdown-menu-end show">
                    <li><button class="dropdown-item"
                                    @onclick="async () => { await ExportResume(); CloseExportJsonMenu(); }">Resume (JSON)</button>
                    </li>
                    <li><button class="dropdown-item"
                                    @onclick="async () => { await ExportLibrary(); CloseExportJsonMenu(); }">Library (JSON)</button>
                    </li>
                </ul>
            }
        </div>

        <button class="btn btn-sm" @onclick="LoadSample">Load Sample</button>

        <button class="btn btn-danger btn-sm" @onclick="Clear">Clear</button>

        <button class="btn btn-sm" @onclick="Save">Save</button>

        <div class="dropdown">
            <button class="btn btn-primary btn-sm dropdown-toggle" type="button" @onclick="ToggleExportMenu"
                    aria-expanded="@_exportMenuOpen">
                Download<span class="dropdown-caret"></span>
            </button>
            @if (_exportMenuOpen)
            {
                <ul class="dropdown-menu dropdown-menu-end show">
                    <li><button class="dropdown-item"
                                    @onclick="async () => { await DownloadTextPdf(); CloseExportMenu(); }">PDF (text)</button>
                    </li>
                    <li><button class="dropdown-item" @onclick="() => { ImagePdf(); CloseExportMenu(); }">Image PDF</button>
                    </li>
                    <li><button class="dropdown-item"
                                    @onclick="async () => { await DownloadMarkdown(); CloseExportMenu(); }">Markdown</button></li>
                    </ul>
                }
            </div>

            @if (_exportMenuOpen || _exportJsonMenuOpen)
            {
                <div class="dropdown-backdrop" @onclick="() => { CloseExportMenu(); CloseExportJsonMenu(); }"></div>
            }
        </div>
    </div>
</div>

    <div class="builder-body d-flex">
        <aside class="resume-sidebar">
            <div class="sidebar-head">
                <div class="sidebar-title">
                    <strong>Resumes</strong>
                    <span class="resume-count">@State.Resumes.Count()</span>
                </div>
                <div class="d-flex flex-items-center gap-2">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-primary" title="New resume" @onclick="ToggleNewMenu"
                                aria-expanded="@_newMenuOpen">+ New<span class="dropdown-caret"></span></button>
                        @if (_newMenuOpen)
                        {
                            <ul class="dropdown-menu show dropdown-menu-end">
                                <li><button class="dropdown-item" @onclick="() => NewResume(false)">Blank resume</button></li>
                                <li><button class="dropdown-item" @onclick="() => NewResume(true)">From sample</button></li>
                            </ul>
                        }
                    </div>
                </div>
                @if (_newMenuOpen)
                {
                    <div class="dropdown-backdrop" @onclick="CloseNewMenu"></div>
                }
            </div>
            <div class="sidebar-list flex-1 overflow-auto">
                @foreach (var r in State.Resumes)
                {
                    <div class="resume-item @(r.Id == State.ActiveId ? "active" : "")" @onclick="() => OpenResume(r.Id)">
                        <span class="resume-dot" style="background: @SchemeColor(r.Resume.ColorScheme)"></span>
                        <div class="resume-item-main">
                            @if (_editingId == r.Id)
                            {
                                <input class="form-control form-control-sm resume-rename" @bind="_editingName" @bind:event="oninput"
                                       @onclick:stopPropagation @onblur="() => CommitRename(r.Id)" @onkeydown="OnRenameKey" />
                            }
                            else
                            {
                                <div class="resume-name" title="Double-click to rename" @ondblclick="e => StartRename(e, r.Id)"
                                     @ondblclick:stopPropagation>@r.Name</div>
                                <div class="resume-meta">
                                    @RelativeTime(r.UpdatedAt)
                                    @if (r.Id == State.ActiveId)
                                    {
                                        <span class="resume-status Label @(State.IsDirty ? "Label--warning" : "Label--success")">
                                            @(State.IsDirty ? "Unsaved" : "Saved")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                        @if (_editingId != r.Id)
                        {
                            <div class="resume-item-actions">
                                <button class="btn btn-sm btn-icon rename-btn" title="Rename" @onclick="e => StartRename(e, r.Id)"
                                        @onclick:stopPropagation>✎</button>
                                <span class="hover-actions">
                                    <button class="btn btn-sm btn-icon" title="Duplicate" @onclick="e => Duplicate(e, r.Id)"
                                            @onclick:stopPropagation>⧉</button>
                                    <button class="btn btn-sm btn-icon color-fg-danger" title="Delete"
                                            @onclick="e => Delete(e, r.Id)" @onclick:stopPropagation>🗑</button>
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="sidebar-footer">
                Powered by <a href="https://duyhuynh.net" target="_blank" rel="noopener noreferrer">duyhuynh.net</a>
            </div>
        </aside>

        <div class="builder-split flex-1">
            <div class="editor-pane p-3">
                <ResumeEditor @key="State.Resume" />
            </div>
            <div class="preview-pane color-bg-muted p-3">
                <ResumePreview @key="State.Resume" />
            </div>
        </div>
    </div>

<InputFile id="importFile" OnChange="OnFile" class="d-none" />

@code {
    private System.Timers.Timer? _saveTimer;
    private DotNetObjectReference<Home>? _dotNetRef;
    private string? _editingId;
    private string _editingName = "";

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        State.OnHistoryChange += OnHistoryChanged;
        _saveTimer = new System.Timers.Timer(600) { AutoReset = false };
        _saveTimer.Elapsed += async (_, _) => await InvokeAsync(async () => await Storage.SaveLibraryAsync(State.Library));
        _ = LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("shortcuts.register", _dotNetRef);
        }
    }

    private async Task LoadAsync()
    {
        var lib = await Storage.LoadLibraryAsync();
        State.LoadLibrary(lib);
        await Storage.SaveLibraryAsync(State.Library);
    }

    private void OnStateChanged()
    {
        StateHasChanged();
        JS.InvokeVoidAsync("setDocumentTitle", TabTitle());
        _saveTimer?.Stop();
        _saveTimer?.Start();
    }

    private string TabTitle()
    {
        var name = State.Library.GetActive()?.Name;
        return string.IsNullOrWhiteSpace(name) ? "Resume Builder — REM" : $"{name} — Resume Builder — REM";
    }

    private void OnHistoryChanged() => StateHasChanged();

    private void OnThemeChange(ChangeEventArgs e)
    {
        State.Resume.Theme = e.Value?.ToString() ?? "default";
        State.MarkDirty();
    }

    private void OnSchemeChange(ChangeEventArgs e)
    {
        State.Resume.ColorScheme = e.Value?.ToString() ?? "blue";
        State.MarkDirty();
    }

    private void OnFontSizeChange(ChangeEventArgs e)
    {
        State.Resume.FontSize = e.Value?.ToString() ?? "medium";
        State.MarkDirty();
    }

    [JSInvokable]
    public void Undo() => State.Undo();

    [JSInvokable]
    public void Redo() => State.Redo();

    private async Task ExportResume() => await Storage.ExportAsync(State.Resume);

    private async Task ExportLibrary() => await Storage.ExportLibraryAsync(State.Library);

    private async Task Save()
    {
        await Storage.SaveLibraryAsync(State.Library);
        State.MarkSaved();
    }

    private async Task LoadSample()
    {
        State.SetResume(SampleResume.Create());
        await Storage.SaveLibraryAsync(State.Library);
    }

    private async Task Clear()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Clear all resume data? This cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        State.SetResume(new ResumeDocument());
        await Storage.SaveLibraryAsync(State.Library);
    }

    private void Import() => JS.InvokeVoidAsync("clickEl", "importFile");

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        using var reader = new StreamReader(file.OpenReadStream(10_000_000));
        var json = await reader.ReadToEndAsync();

        var library = Storage.TryImportLibrary(json);
        if (library is not null)
        {
            State.ImportLibrary(library);
            await Storage.SaveLibraryAsync(State.Library);
            return;
        }

        var doc = Storage.ImportResume(json);
        State.SetResume(doc);
        await Storage.SaveLibraryAsync(State.Library);
    }

    private void PreviewPdf() => JS.InvokeVoidAsync("previewPdf");

    private async Task DownloadTextPdf()
    {
        var json = PdfService.BuildDocDefinitionJson(State.Resume);
        var name = State.Resume.Personal.FullName;
        var filename = string.IsNullOrWhiteSpace(name) ? "resume.pdf" : $"{name}-Resume.pdf";
        await JS.InvokeVoidAsync("exportTextPdf", filename, json);
    }

    private void ImagePdf()
    {
        var name = State.Resume.Personal.FullName;
        var filename = string.IsNullOrWhiteSpace(name) ? "resume.pdf" : $"{name}-Resume.pdf";
        JS.InvokeVoidAsync("exportImagePdf", filename);
    }

    private async Task DownloadMarkdown()
    {
        var md = StorageService.ToMarkdown(State.Resume);
        var name = State.Resume.Personal.FullName;
        var filename = string.IsNullOrWhiteSpace(name) ? "resume.md" : $"{name}-Resume.md";
        await JS.InvokeVoidAsync("storage.downloadFile", filename, md);
    }

    // ----- Sidebar actions -----
    private static string SchemeColor(string scheme) => scheme switch
    {
        "indigo" => "#4f46e5",
        "emerald" => "#059669",
        "rose" => "#e11d48",
        "amber" => "#d97706",
        "violet" => "#7c3aed",
        "teal" => "#0d9488",
        "slate" => "#475569",
        _ => "#1b6ec2"
    };

    private void OpenResume(string id) => State.SetActive(id);

    private void NewResume(bool fromSample)
    {
        State.CreateResume(fromSample ? "Resume (sample)" : "New Resume", fromSample);
        _newMenuOpen = false;
    }

    private bool _newMenuOpen;

    private void ToggleNewMenu() => _newMenuOpen = !_newMenuOpen;

    private void CloseNewMenu() => _newMenuOpen = false;

    private bool _mobileMenuOpen;

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private bool _exportMenuOpen;

    private void ToggleExportMenu() => _exportMenuOpen = !_exportMenuOpen;

    private void CloseExportMenu() => _exportMenuOpen = false;

    private bool _exportJsonMenuOpen;

    private void ToggleExportJsonMenu() => _exportJsonMenuOpen = !_exportJsonMenuOpen;

    private void CloseExportJsonMenu() => _exportJsonMenuOpen = false;

    private void StartRename(MouseEventArgs _, string id)
    {
        _editingId = id;
        _editingName = State.Resumes.First(r => r.Id == id).Name;
    }

    private void OnRenameKey(KeyboardEventArgs e)
    {
        if (_editingId is null)
        {
            return;
        }

        if (e.Key == "Enter")
        {
            CommitRename(_editingId);
        }
        else if (e.Key == "Escape")
        {
            _editingId = null;
        }
    }

    private void CommitRename(string id)
    {
        if (_editingId != id)
        {
            return;
        }

        State.RenameResume(id, _editingName);
        _editingId = null;
    }

    private void Duplicate(MouseEventArgs _, string id) => State.DuplicateResume(id);

    private async Task Delete(MouseEventArgs _, string id)
    {
        var entry = State.Resumes.First(r => r.Id == id);
        var ok = await JS.InvokeAsync<bool>("confirm", $"Delete '{entry.Name}'? This cannot be undone.");
        if (ok)
        {
            State.DeleteResume(id);
        }
    }

    private static string RelativeTime(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalSeconds < 60)
        {
            return "just now";
        }

        if (diff.TotalMinutes < 60)
        {
            return $"{(int)diff.TotalMinutes}m ago";
        }

        if (diff.TotalHours < 24)
        {
            return $"{(int)diff.TotalHours}h ago";
        }

        if (diff.TotalDays < 30)
        {
            return $"{(int)diff.TotalDays}d ago";
        }

        return dt.ToString("MMM d");
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        State.OnHistoryChange -= OnHistoryChanged;
        _saveTimer?.Dispose();
        if (_dotNetRef is not null)
        {
            JS.InvokeVoidAsync("shortcuts.unregister");
            _dotNetRef.Dispose();
        }
    }
}
