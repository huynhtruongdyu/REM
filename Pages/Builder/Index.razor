@page "/builder"
@layout BuilderLayout
@inject ResumeState State
@inject StorageService Storage
@inject IJSRuntime JS
@implements IDisposable

<div class="builder-toolbar d-flex gap-2 align-items-center px-3 py-2 border-bottom bg-white">
    <strong>Resume Builder</strong>
    <span class="badge @(State.IsDirty ? "bg-warning text-dark" : "bg-success")">
        @(State.IsDirty ? "Unsaved" : "Saved")
    </span>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => State.Undo()" disabled="@(!State.CanUndo)" title="Undo (Ctrl+Z)">Undo</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => State.Redo()" disabled="@(!State.CanRedo)" title="Redo (Ctrl+Y)">Redo</button>
    </div>
    <div class="d-flex align-items-center gap-2">
        <label class="form-label mb-0 small" for="themeSelect">Theme</label>
        <select id="themeSelect" class="form-select form-select-sm w-auto" value="@State.Resume.Theme" @onchange="OnThemeChange">
            <option value="default">Default</option>
            <option value="minimal">Minimalism</option>
            <option value="modern">Modern</option>
        </select>
    </div>
    <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="Import">Import</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Export">Export</button>
        <button class="btn btn-sm btn-primary" @onclick="Save">Save</button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadSample">Sample</button>
        <button class="btn btn-sm btn-outline-danger" @onclick="Clear">Clear</button>
        <button class="btn btn-sm btn-outline-primary" @onclick="Print">Print / PDF</button>
    </div>
</div>

<div class="builder-split">
    <div class="editor-pane p-3">
        <ResumeEditor @key="State.Resume" />
    </div>
    <div class="preview-pane bg-light p-3">
        <ResumePreview @key="State.Resume" />
    </div>
</div>

<InputFile id="importFile" OnChange="OnFile" class="d-none" />

@code {
    private System.Timers.Timer? _saveTimer;
    private DotNetObjectReference<Index>? _dotNetRef;

    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
        State.OnHistoryChange += OnHistoryChanged;
        _saveTimer = new System.Timers.Timer(600) { AutoReset = false };
        _saveTimer.Elapsed += async (_, _) => await InvokeAsync(async () => await Storage.SaveAsync(State.Resume));
        _ = LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("shortcuts.register", _dotNetRef);
        }
    }

    private async Task LoadAsync()
    {
        var doc = await Storage.LoadAsync();
        if (doc is null)
        {
            doc = SampleResume.Create();
            await Storage.SaveAsync(doc);
        }

        State.SetResume(doc, recordHistory: false);
    }

    private void OnStateChanged()
    {
        StateHasChanged();
        _saveTimer?.Stop();
        _saveTimer?.Start();
    }

    private void OnHistoryChanged() => StateHasChanged();

    private void OnThemeChange(ChangeEventArgs e)
    {
        State.Resume.Theme = e.Value?.ToString() ?? "default";
        State.MarkDirty();
    }

    [JSInvokable]
    public void Undo() => State.Undo();

    [JSInvokable]
    public void Redo() => State.Redo();

    private async Task Export() => await Storage.ExportAsync(State.Resume);

    private async Task Save()
    {
        await Storage.SaveAsync(State.Resume);
        State.MarkSaved();
    }

    private async Task LoadSample()
    {
        State.SetResume(SampleResume.Create());
        await Storage.SaveAsync(State.Resume);
    }

    private async Task Clear()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Clear all resume data? This cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        State.SetResume(new ResumeDocument());
        await Storage.SaveAsync(State.Resume);
    }

    private void Import() => JS.InvokeVoidAsync("clickEl", "importFile");

    private async Task OnFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        using var reader = new StreamReader(file.OpenReadStream(10_000_000));
        var json = await reader.ReadToEndAsync();
        var doc = Storage.Import(json);
        State.SetResume(doc);
    }

    private void Print() => JS.InvokeVoidAsync("window.print");

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        State.OnHistoryChange -= OnHistoryChanged;
        _saveTimer?.Dispose();
        if (_dotNetRef is not null)
        {
            JS.InvokeVoidAsync("shortcuts.unregister");
            _dotNetRef.Dispose();
        }
    }
}
